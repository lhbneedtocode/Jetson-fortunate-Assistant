* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  background:
    radial-gradient(circle at top left, rgba(174, 53, 53, 0.2), transparent 35%),
    linear-gradient(135deg, #1c1412, #2b1a16 45%, #111);
  color: #f7efe8;
  min-height: 100vh;
}

.page {
  width: min(1200px, 94vw);
  margin: 0 auto;
  padding: 36px 0 48px;
}

.hero {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: stretch;
  margin-bottom: 28px;
}

.eyebrow {
  color: #d9a867;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  font-size: 13px;
  margin: 0 0 8px;
}

h1 {
  font-size: clamp(38px, 6vw, 72px);
  line-height: 1;
  margin: 0;
}

.subtitle {
  color: #d8c7ba;
  max-width: 720px;
  font-size: 17px;
  line-height: 1.7;
}

.hero-card {
  min-width: 220px;
  padding: 22px;
  border: 1px solid rgba(255, 221, 170, 0.18);
  border-radius: 24px;
  background: rgba(255, 255, 255, 0.08);
  box-shadow: 0 18px 50px rgba(0, 0, 0, 0.25);
  display: grid;
  place-items: center;
  text-align: center;
}

.seal {
  width: 72px;
  height: 72px;
  border-radius: 22px;
  background: #b8322d;
  display: grid;
  place-items: center;
  font-size: 38px;
  font-weight: 800;
  box-shadow: inset 0 -10px 20px rgba(0,0,0,0.18);
}

.layout {
  display: grid;
  grid-template-columns: 0.9fr 1.3fr;
  gap: 24px;
}

.panel {
  border-radius: 28px;
  padding: 24px;
  border: 1px solid rgba(255, 221, 170, 0.16);
  background: rgba(255, 255, 255, 0.09);
  backdrop-filter: blur(14px);
  box-shadow: 0 24px 80px rgba(0,0,0,0.28);
}

h2 {
  margin: 0 0 18px;
  font-size: 24px;
}

.field {
  display: block;
  margin-bottom: 16px;
}

.field span {
  display: block;
  margin-bottom: 8px;
  color: #f1d9bd;
  font-size: 14px;
}

input, textarea, select {
  width: 100%;
  border: 1px solid rgba(255,255,255,0.18);
  background: rgba(16, 10, 8, 0.72);
  color: #fff;
  border-radius: 16px;
  padding: 13px 14px;
  font-size: 15px;
  outline: none;
}

textarea {
  resize: vertical;
  min-height: 110px;
}

input:focus, textarea:focus, select:focus {
  border-color: #e3aa62;
  box-shadow: 0 0 0 3px rgba(227, 170, 98, 0.18);
}

.grid-2 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
}

.primary-btn, .ghost-btn {
  border: none;
  cursor: pointer;
  border-radius: 18px;
  font-size: 16px;
}

.primary-btn {
  width: 100%;
  padding: 15px 18px;
  color: #25110c;
  font-weight: 800;
  background: linear-gradient(135deg, #ffd08a, #e89b4d);
  box-shadow: 0 14px 32px rgba(232, 155, 77, 0.28);
}

.primary-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.ghost-btn {
  padding: 10px 14px;
  color: #f3d7bd;
  background: rgba(255,255,255,0.08);
  border: 1px solid rgba(255,255,255,0.14);
}

.notice, .muted {
  color: #c9b8ad;
  font-size: 13px;
  line-height: 1.6;
}

.result-header {
  display: flex;
  align-items: start;
  justify-content: space-between;
  gap: 16px;
}

.meta {
  margin: -8px 0 0;
  color: #d7b58b;
  font-size: 14px;
}

.loading {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 18px 0;
  color: #ffd08a;
}

.hidden {
  display: none;
}

.spinner {
  width: 18px;
  height: 18px;
  border: 3px solid rgba(255,255,255,0.18);
  border-top-color: #ffd08a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.answer {
  white-space: pre-wrap;
  line-height: 1.85;
  background: rgba(15, 9, 6, 0.62);
  border: 1px solid rgba(255,255,255,0.12);
  border-radius: 22px;
  padding: 20px;
  min-height: 260px;
  font-size: 15.5px;
}

.answer.empty {
  color: #bdaea2;
}

.evidence-section {
  margin-top: 22px;
}

.evidence-section h3 {
  margin: 0 0 12px;
  color: #f5d8b7;
}

.evidence-list {
  display: grid;
  gap: 12px;
}

.evidence-card {
  border-radius: 18px;
  padding: 14px;
  background: rgba(255,255,255,0.07);
  border: 1px solid rgba(255,255,255,0.1);
}

.evidence-title {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  color: #ffd08a;
  margin-bottom: 8px;
  font-size: 14px;
}

.evidence-card p {
  color: #e9dbce;
  line-height: 1.65;
  margin: 0 0 10px;
  font-size: 14px;
}

.evidence-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.evidence-meta span {
  font-size: 12px;
  color: #d6c2ae;
  background: rgba(0,0,0,0.22);
  padding: 5px 8px;
  border-radius: 999px;
}

@media (max-width: 900px) {
  .hero, .layout {
    grid-template-columns: 1fr;
    display: grid;
  }

  .hero-card {
    min-width: unset;
  }

  .grid-2 {
    grid-template-columns: 1fr;
  }
}
/* ===== Visualization Dashboard ===== */

.sign-card {
  margin: 16px 0 18px;
  padding: 18px;
  border-radius: 22px;
  background: linear-gradient(135deg, rgba(184, 50, 45, 0.28), rgba(255, 208, 138, 0.12));
  border: 1px solid rgba(255, 208, 138, 0.22);
}

.sign-card-main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 12px;
}

.sign-number {
  font-size: 24px;
  font-weight: 900;
}

.sign-level {
  padding: 8px 14px;
  border-radius: 999px;
  background: rgba(255, 208, 138, 0.18);
  color: #ffd08a;
}

.sign-card-sub {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  color: #f1d9bd;
  margin-bottom: 12px;
}

.badges {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.badges span {
  font-size: 12px;
  color: #f4dfc8;
  background: rgba(0, 0, 0, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.1);
  padding: 6px 9px;
  border-radius: 999px;
}

.score-bars {
  display: grid;
  gap: 12px;
  margin-bottom: 18px;
}

.score-row {
  display: grid;
  grid-template-columns: 170px 1fr 58px;
  align-items: center;
  gap: 12px;
  padding: 12px;
  border-radius: 16px;
  background: rgba(255, 255, 255, 0.06);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.score-info {
  display: grid;
  gap: 3px;
}

.score-info strong {
  color: #ffd08a;
  font-size: 13px;
}

.score-info span {
  color: #e7d4c1;
  font-size: 12px;
}

.score-track {
  height: 12px;
  border-radius: 999px;
  overflow: hidden;
  background: rgba(0, 0, 0, 0.3);
}

.score-fill {
  height: 100%;
  border-radius: 999px;
  background: linear-gradient(90deg, #ffd08a, #e89b4d);
}

.score-value {
  color: #f1d9bd;
  text-align: right;
  font-variant-numeric: tabular-nums;
  font-size: 13px;
}

.dashboard-panel {
  margin-top: 24px;
}

.metrics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  margin: 22px 0;
}

.metric-card {
  padding: 18px;
  border-radius: 20px;
  background: rgba(15, 9, 6, 0.62);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.metric-card span {
  display: block;
  color: #d7b58b;
  margin-bottom: 8px;
}

.metric-card strong {
  color: #ffd08a;
  font-size: 30px;
}

.figure-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
}

.figure-grid figure {
  margin: 0;
  border-radius: 22px;
  padding: 14px;
  background: rgba(15, 9, 6, 0.55);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.figure-grid figure.missing {
  display: none;
}

.figure-grid img {
  width: 100%;
  border-radius: 16px;
  background: #fff;
  display: block;
}

.figure-grid figcaption {
  color: #e6d0bb;
  line-height: 1.55;
  font-size: 13px;
  margin-top: 10px;
}

@media (max-width: 900px) {
  .score-row {
    grid-template-columns: 1fr;
  }

  .score-value {
    text-align: left;
  }

  .metrics-grid,
  .figure-grid {
    grid-template-columns: 1fr;
  }
}

.dashboard-note {
  margin-top: 14px;
  padding: 14px 16px;
  border-radius: 16px;
  background: rgba(15, 9, 6, 0.45);
  border: 1px solid rgba(255, 255, 255, 0.08);
}

.dashboard-note code {
  color: #ffd08a;
}

/* ===== 100-sign dynamic map ===== */

.sign-map-section {
  margin: 18px 0;
  padding: 16px;
  border-radius: 22px;
  background: rgba(15, 9, 6, 0.5);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.sign-map-header {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: flex-start;
  margin-bottom: 14px;
}

.sign-map-header h3 {
  margin: 0 0 4px;
  color: #f5d8b7;
}

.sign-map-legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  justify-content: flex-end;
  font-size: 12px;
  color: #e6d0bb;
}

.sign-map-legend span {
  display: inline-flex;
  align-items: center;
  gap: 5px;
}

.legend-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  display: inline-block;
}

.sign-map {
  display: grid;
  grid-template-columns: repeat(10, minmax(0, 1fr));
  gap: 7px;
}

.sign-cell {
  position: relative;
  height: 42px;
  border-radius: 12px;
  border: 1px solid rgba(255, 255, 255, 0.12);
  color: #fff;
  display: grid;
  place-items: center;
  font-weight: 800;
  font-size: 13px;
  cursor: default;
  transition: transform 0.16s ease, box-shadow 0.16s ease, border-color 0.16s ease;
}

.sign-cell:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 22px rgba(0, 0, 0, 0.22);
}

.sign-cell.selected {
  transform: scale(1.08);
  border: 2px solid #fff3c4;
  box-shadow:
    0 0 0 4px rgba(255, 208, 138, 0.22),
    0 12px 28px rgba(255, 208, 138, 0.25);
  z-index: 2;
}

.sign-cell .sign-tooltip {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 8px);
  transform: translateX(-50%);
  min-width: 150px;
  padding: 8px 10px;
  border-radius: 12px;
  background: rgba(12, 8, 6, 0.95);
  color: #f7efe8;
  border: 1px solid rgba(255, 208, 138, 0.22);
  font-size: 12px;
  line-height: 1.45;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.16s ease;
  white-space: nowrap;
}

.sign-cell:hover .sign-tooltip {
  opacity: 1;
}

.level-best {
  background: linear-gradient(135deg, #ffdf82, #d89b24);
}

.level-good {
  background: linear-gradient(135deg, #f4c96a, #b8872e);
}

.level-midgood {
  background: linear-gradient(135deg, #72c98c, #2e7c48);
}

.level-neutral {
  background: linear-gradient(135deg, #7d91aa, #3d4c61);
}

.level-bad {
  background: linear-gradient(135deg, #b24a4a, #651f1f);
}

.level-unknown {
  background: linear-gradient(135deg, #777, #444);
}

@media (max-width: 900px) {
  .sign-map {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .sign-map-header {
    display: block;
  }

  .sign-map-legend {
    justify-content: flex-start;
    margin-top: 10px;
  }
}
