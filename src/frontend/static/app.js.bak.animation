const $ = (id) => document.getElementById(id);

const apiBaseInput = $("apiBase");
const questionInput = $("question");
const aspectInput = $("aspect");
const drawModeInput = $("drawMode");
const signIdInput = $("signId");
const signIdField = $("signIdField");
const submitBtn = $("submitBtn");
const clearBtn = $("clearBtn");
const loading = $("loading");
const answerBox = $("answer");
const metaBox = $("meta");
const evidenceList = $("evidenceList");
const scoreBars = $("scoreBars");

const signCard = $("signCard");
const signNumber = $("signNumber");
const signLevel = $("signLevel");
const storyTitle = $("storyTitle");
const aspectLabel = $("aspectLabel");
const chunkTypeBadges = $("chunkTypeBadges");
const signMap = $("signMap");

let signSummary = [];

function defaultApiBase() {
  if (window.location.protocol === "file:") {
    return "http://localhost:8080";
  }

  if (window.location.port && window.location.port !== "8080") {
    return `${window.location.protocol}//${window.location.hostname}:8080`;
  }

  return "";
}

apiBaseInput.value = localStorage.getItem("fortune_api_base") || defaultApiBase();

drawModeInput.addEventListener("change", () => {
  signIdField.style.display = drawModeInput.value === "fixed" ? "block" : "none";
});

drawModeInput.dispatchEvent(new Event("change"));

function getApiBase() {
  const value = apiBaseInput.value.trim();
  localStorage.setItem("fortune_api_base", value);
  return value.replace(/\/$/, "");
}

function formatAnswer(text) {
  if (!text) return "";
  return text.replace(/\\n/g, "\n").replace(/\n{3,}/g, "\n\n").trim();
}

function renderSignCard(data) {
  const firstEvidence = (data.evidence || [])[0] || {};
  const firstMeta = firstEvidence.metadata || {};
  const firstCitation = (data.citations || [])[0] || {};

  const sid = data.sign_id || firstMeta.sign_id || "---";
  const level = firstMeta.level || firstCitation.level || "---";
  const story = firstMeta.story_title || firstCitation.story_title || "---";
  const aspect = firstMeta.aspect_label || firstCitation.aspect_label || data.aspect || "---";

  signNumber.textContent = `第 ${sid} 签`;
  signLevel.textContent = level;
  storyTitle.textContent = `典故：${story}`;
  aspectLabel.textContent = `方向：${aspect}`;

  const labels = new Set();
  (data.evidence || []).forEach((item) => {
    const meta = item.metadata || {};
    labels.add(`${meta.aspect_label || meta.aspect || "-"} · ${meta.chunk_type || "-"}`);
  });

  chunkTypeBadges.innerHTML = "";
  Array.from(labels).slice(0, 6).forEach((label) => {
    const badge = document.createElement("span");
    badge.textContent = label;
    chunkTypeBadges.appendChild(badge);
  });

  signCard.classList.remove("hidden");
}

function renderScoreBars(items = []) {
  scoreBars.innerHTML = "";

  if (!items.length) {
    scoreBars.innerHTML = `<p class="muted">暂无 RAG 检索分数。</p>`;
    return;
  }

  const maxScore = Math.max(...items.map((item) => item.score || 0), 0.001);

  items.slice(0, 6).forEach((item, index) => {
    const meta = item.metadata || {};
    const score = typeof item.score === "number" ? item.score : 0;
    const width = Math.max(4, Math.round((score / maxScore) * 100));

    const row = document.createElement("div");
    row.className = "score-row";
    row.innerHTML = `
      <div class="score-info">
        <strong>Rank ${index + 1}</strong>
        <span>${meta.aspect_label || meta.aspect || "-"} / ${meta.chunk_type || "-"}</span>
      </div>
      <div class="score-track">
        <div class="score-fill" style="width:${width}%"></div>
      </div>
      <div class="score-value">${score.toFixed(3)}</div>
    `;
    scoreBars.appendChild(row);
  });
}

function renderEvidence(items = []) {
  evidenceList.innerHTML = "";

  if (!items.length) {
    evidenceList.innerHTML = `<p class="muted">暂无检索依据。</p>`;
    return;
  }

  items.slice(0, 6).forEach((item, index) => {
    const metadata = item.metadata || {};
    const card = document.createElement("div");
    card.className = "evidence-card";

    card.innerHTML = `
      <div class="evidence-title">
        <strong>资料 ${index + 1}</strong>
        <span>${metadata.sign_id || "-"} · ${metadata.aspect_label || metadata.aspect || "-"} · ${metadata.chunk_type || "-"}</span>
      </div>
      <p>${item.snippet || ""}</p>
      <div class="evidence-meta">
        <span>吉凶：${metadata.level || "-"}</span>
        <span>典故：${metadata.story_title || "-"}</span>
        <span>score：${typeof item.score === "number" ? item.score.toFixed(3) : "-"}</span>
      </div>
    `;

    evidenceList.appendChild(card);
  });
}

async function loadMetrics() {
  try {
    const res = await fetch("./eval/wts_retrieval_metrics.json", { cache: "no-store" });
    if (!res.ok) return;

    const data = await res.json();
    const overall = data.overall || data;

    if (typeof overall.hit_at_1 === "number") {
      $("hit1Metric").textContent = overall.hit_at_1.toFixed(3);
    }

    if (typeof overall.hit_at_3 === "number") {
      $("hit3Metric").textContent = overall.hit_at_3.toFixed(3);
    }

    if (typeof overall.mrr === "number") {
      $("mrrMetric").textContent = overall.mrr.toFixed(3);
    }
  } catch (err) {
    console.warn("No retrieval metrics JSON found yet.", err);
  }
}


async function loadSignMap() {
  if (!signMap) return;

  try {
    const res = await fetch("./data/signs_summary.json", { cache: "no-store" });

    if (!res.ok) {
      throw new Error(`HTTP ${res.status}`);
    }

    signSummary = await res.json();
    renderSignMap(signSummary);
  } catch (err) {
    console.warn("Failed to load sign summary:", err);
    signMap.innerHTML = `<p class="muted">100 签签盘数据尚未生成，请运行 scripts/11_export_sign_summary.py。</p>`;
  }
}

function renderSignMap(signs) {
  if (!signMap) return;

  signMap.innerHTML = "";

  signs.forEach((item) => {
    const cell = document.createElement("div");
    cell.className = `sign-cell ${item.level_class || "level-unknown"}`;
    cell.dataset.signId = item.sign_id;

    const keywordText = Array.isArray(item.keywords) && item.keywords.length
      ? `关键词：${item.keywords.join("、")}`
      : "关键词：-";

    cell.innerHTML = `
      <span>${item.sign_id}</span>
      <div class="sign-tooltip">
        <strong>第 ${item.sign_id} 签</strong><br/>
        吉凶：${item.level || "-"}<br/>
        典故：${item.story_title || "-"}<br/>
        ${keywordText}
      </div>
    `;

    signMap.appendChild(cell);
  });
}

function highlightSignMap(signId) {
  if (!signMap) return;

  const normalized = String(signId || "").padStart(3, "0");

  signMap.querySelectorAll(".sign-cell").forEach((cell) => {
    cell.classList.toggle("selected", cell.dataset.signId === normalized);
  });

  const selected = signMap.querySelector(`.sign-cell[data-sign-id="${normalized}"]`);
  if (selected) {
    selected.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "nearest" });
  }
}

async function submitFortune() {
  const question = questionInput.value.trim();

  if (!question) {
    alert("请先输入你的问题。");
    return;
  }

  const apiBase = getApiBase();
  const aspect = aspectInput.value.trim();
  const drawMode = drawModeInput.value;
  const fixedSignId = signIdInput.value.trim();

  const payload = { question };

  if (aspect) {
    payload.aspect = aspect;
  }

  if (drawMode === "fixed" && fixedSignId) {
    payload.sign_id = fixedSignId;
  }

  submitBtn.disabled = true;
  loading.classList.remove("hidden");
  answerBox.classList.remove("empty");
  answerBox.textContent = "";
  metaBox.textContent = "正在生成...";
  evidenceList.innerHTML = "";
  scoreBars.innerHTML = "";
  signCard.classList.add("hidden");
  highlightSignMap(null);

  try {
    const res = await fetch(`${apiBase}/api/fortune`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    if (!res.ok) {
      const errText = await res.text();
      throw new Error(`HTTP ${res.status}: ${errText}`);
    }

    const data = await res.json();

    metaBox.textContent = `第 ${data.sign_id} 签 ｜ 方向：${data.aspect} ｜ ${data.sign_key}`;
    answerBox.textContent = formatAnswer(data.answer);
    renderSignCard(data);
    highlightSignMap(data.sign_id);
    renderScoreBars(data.evidence || []);
    renderEvidence(data.evidence || []);
  } catch (err) {
    console.error(err);
    metaBox.textContent = "请求失败";
    answerBox.textContent = `请求失败：${err.message}

请检查：
1. FastAPI 后端是否已启动在 8080 端口；
2. API 地址是否正确；
3. Qwen/vLLM 是否运行在 8000 端口；
4. 浏览器是否能访问服务器 IP。`;
    renderScoreBars([]);
    renderEvidence([]);
  } finally {
    submitBtn.disabled = false;
    loading.classList.add("hidden");
  }
}

function clearAll() {
  questionInput.value = "";
  answerBox.textContent = "请在左侧输入问题，然后点击“开始求签解签”。";
  answerBox.classList.add("empty");
  metaBox.textContent = "等待求签...";
  evidenceList.innerHTML = "";
  scoreBars.innerHTML = "";
  signCard.classList.add("hidden");
}

submitBtn.addEventListener("click", submitFortune);
clearBtn.addEventListener("click", clearAll);

questionInput.addEventListener("keydown", (event) => {
  if ((event.metaKey || event.ctrlKey) && event.key === "Enter") {
    submitFortune();
  }
});

loadMetrics();
loadSignMap();